generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preference UserPreference?
  roadmap    Roadmap?
  dailyTasks DailyTask[]
  activeDays ActiveDay[]
}

model UserPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  goal           String
  goalCustom     String?
  targetDays     Int
  selectedSkills String[]
  hoursPerDay    Float?
  timezone       String?  // IANA timezone user (mis. "Asia/Jakarta"), untuk perhitungan streak
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id         String   @id @default(uuid())
  userId     String   @unique
  goal       String
  targetDays Int
  reasoning  String?  // Alasan keseluruhan roadmap dari AI + saran belajar (Bahasa Indonesia)
  phases     Json     // Array of phase objects: [{title, week, order, topics, duration}]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyTask {
  id        String   @id @default(uuid())
  userId    String
  day       Int      // 1, 2, 3, ... targetDays
  tasks     Json     // Array of task objects: [{title, duration_minutes, resources, completed}]
  reasoning String?  // Alasan AI mengapa task pada batch ini dipilih
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// Mencatat tanggal kalender (YYYY-MM-DD di timezone user) di mana user melakukan
// minimal 1 checklist task. Tetap tersimpan walau task di-uncheck (hari tetap aktif).
model ActiveDay {
  id     String @id @default(uuid())
  userId String
  date   String // YYYY-MM-DD di timezone user
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}