generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preference UserPreference?
  roadmap    Roadmap?
  dailyTasks DailyTask[]
}

model UserPreference {
  id             String   @id @default(uuid())
  userId         String   @unique
  goal           String
  goalCustom     String?
  targetDays     Int
  selectedSkills String[]
  hoursPerDay    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id         String   @id @default(uuid())
  userId     String   @unique
  goal       String
  targetDays Int
  phases     Json     // Array of phase objects: [{title, week, order, topics, duration}]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyTask {
  id        String   @id @default(uuid())
  userId    String
  day       Int      // 1, 2, 3, ... targetDays
  tasks     Json     // Array of task objects: [{title, duration_minutes, resources, completed}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}